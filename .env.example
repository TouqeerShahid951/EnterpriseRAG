# Local AgenticRAG development defaults.
# Copy to .env to set local credentials or override typed application defaults
# and Docker Compose topology values.

# Host ports
FRONTEND_PORT=3000
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
VLLM_TEXT_PORT=8010
VLLM_EMBED_PORT=8011
VLLM_VISION_PORT=8016

# Infrastructure credentials and service topology
POSTGRES_DB=agenticrag
POSTGRES_USER=agenticrag
POSTGRES_PASSWORD=agenticrag-local-password
REDIS_PASSWORD=agenticrag-local-redis-password
REDIS_AOF_RECOVERY=repair
MINIO_ACCESS_KEY=agenticrag
MINIO_SECRET_KEY=agenticrag-local-minio-password
MINIO_BUCKET=agenticrag-uploads
CLAMAV_NO_FRESHCLAMD=true
NEO4J_USER=neo4j
NEO4J_PASSWORD=agenticrag-local-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://neo4j:7687

JWT_SECRET_KEY=replace-with-local-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_IDLE_TIMEOUT_MINUTES=30
CSRF_SECRET_KEY=replace-with-local-csrf-secret
SERVICE_TOKEN=replace-with-local-service-token
DEPLOYMENT_CONTROLLER_TOKEN=replace-with-local-deployment-controller-token
CONNECTOR_SECRETS_KEY=replace-with-local-connector-secrets-key
CONNECTOR_SECRETS_KEY_RING=
CONNECTOR_LIVE_SQL_ENABLED=true
CONNECTOR_LIVE_SQL_MAX_ROWS=100
CONNECTOR_LIVE_SQL_TIMEOUT_SECONDS=15
CONNECTOR_LIVE_SQL_MAX_SCHEDULES=5
CONNECTOR_LIVE_SQL_MAX_REPAIR_ATTEMPTS=2
CONNECTOR_LIVE_SQL_RESULT_VERIFIER_ENABLED=true
CONNECTOR_LIVE_SQL_VERIFIER_SAMPLE_ROWS=5
EVALUATION_ANSWER_LLM_VERIFIER_ENABLED=true
EVALUATION_ANSWER_LLM_VERIFIER_MODEL=
APPLICATION_IMAGE_DIGEST=
EVALUATION_HOST_PROFILE=
BOOTSTRAP_ADMIN_EMAIL=admin@prudentia.ai
BOOTSTRAP_ADMIN_PASSWORD=12345678
DEPLOYMENT_CONTROLLER_URL=http://deployment-controller:8080
DEPLOYMENT_CONTROLLER_TIMEOUT_SECONDS=930
DEPLOYMENT_COMPOSE_TIMEOUT_SECONDS=900

# Workspace RAG bootstrap values. These are used only while no workspace RAG
# configuration has been saved from Runtime Settings. A saved workspace record
# remains authoritative until an administrator restores deployment defaults.
RAG_MODEL_PROVIDER=ollama
RAG_EMBEDDING_PROVIDER=fastembed
RAG_FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
# Test-only provider switch; keep disabled in real deployments.
ENABLE_MOCK_MODELS=false
MOCK_LLM=false
MOCK_EMBEDDINGS=false
MOCK_OCR=false
RAG_CHAT_PROVIDER=
RAG_CHAT_BASE_URL=
RAG_CHAT_MODEL=
RAG_REASONING_PROVIDER=
RAG_REASONING_BASE_URL=
RAG_ROUTING_PROVIDER=
RAG_ROUTING_BASE_URL=
RAG_FAITHFULNESS_PROVIDER=
RAG_FAITHFULNESS_BASE_URL=
RAG_INGESTION_PROVIDER=
RAG_INGESTION_BASE_URL=
RAG_VISION_PROVIDER=
RAG_VISION_BASE_URL=
RAG_VISION_MODEL=
VLLM_CHAT_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_BASE_URL=http://vllm-text:8000/v1
VLLM_REASONING_BASE_URL=http://vllm-text:8000/v1
VLLM_ROUTING_BASE_URL=http://vllm-text:8000/v1
VLLM_FAITHFULNESS_BASE_URL=http://vllm-text:8000/v1
VLLM_INGESTION_BASE_URL=http://vllm-text:8000/v1
VLLM_VISION_BASE_URL=http://vllm-vision:8000/v1
VLLM_VISION_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
RAG_REASONING_MODEL=llama3.1:8b
RAG_FAITHFULNESS_MODEL=llama3.1:8b
RAG_FAITHFULNESS_POLICY=never
RAG_ROUTE_LLM_VERIFIER_MODEL=llama3.1:8b
RAG_INGESTION_MODEL=
EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1.5
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_VISION_MODEL=
OLLAMA_NUM_CTX=16384
OLLAMA_VISION_NUM_CTX=8192
OLLAMA_THINKING_ENABLED=false
RAG_HTTP_TIMEOUT_SECONDS=180
RAG_OLLAMA_CHAT_TIMEOUT_SECONDS=180
RAG_OLLAMA_EMBED_TIMEOUT_SECONDS=45

# Build-time cache priming. Keep PREWARM_DOCLING=false for reproducible
# offline rebuilds; seed the local model-cache folders while still connected.
FASTEMBED_CACHE_HOST_DIR=./model-cache/fastembed
DOCLING_CACHE_HOST_DIR=./model-cache/docling
VLLM_CACHE_HOST_DIR=./model-cache/vllm
FOLDER_SOURCES_HOST_DIR=./folder-sources
FOLDER_SOURCES_ROOT=/folder-sources
PREWARM_FASTEMBED=false
PREWARM_DOCLING=false
DOCLING_CONVERT_TIMEOUT_SECONDS=180
DOCLING_OCR_BACKEND=onnxruntime
DOCLING_OCR_LANGS=english
OCR_REVIEW_CONFIDENCE_THRESHOLD=0.9
INGESTION_QUALITY_PRESET=fast
INGEST_HEARTBEAT_INTERVAL_SECONDS=30
INGEST_QUEUE_NAME=ingest:jobs
INGEST_TASK_NAME=apps.ingestion.tasks.ingest_document
INGEST_TASK_SOFT_TIME_LIMIT_SECONDS=1800
INGEST_TASK_TIME_LIMIT_SECONDS=1920
INGEST_WORKER_BOOT_CONCURRENCY=1
INGEST_STALE_AFTER_SECONDS=120
LAYERED_DOCLING_BATCH_PAGES=4
LAYERED_DOCLING_MAX_PAGES=40
NATIVE_TEXT_MIN_CHARS_PER_PAGE=10
OLLAMA_EMBED_BATCH_SIZE=16
OLLAMA_RETRY_BASE_SECONDS=2
PDF_FULL_DOC_WEAK_PAGE_RATIO=0.25
PDF_WEAK_PAGE_THRESHOLD=5
PDF_IMAGE_ANALYSIS_MAX_IMAGES=-1
PDF_IMAGE_ANALYSIS_MAX_FULL_PAGE_FALLBACKS=-1
PDF_IMAGE_REVIEW_THRESHOLD=64
SCANNED_VISUAL_REGION_ENABLED=true
SCANNED_VISUAL_MIN_AREA_RATIO=0.03
SCANNED_VISUAL_MAX_REGIONS_PER_PAGE=-1
SCANNED_VISUAL_TEXT_MASK_PADDING_PX=8
QDRANT_UPSERT_BATCH_SIZE=64
RAG_CHUNK_TARGET_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_PARENT_MAX_TOKENS=2048
METADATA_USE_GLINER=false
METADATA_TOPIC_TAXONOMY=

# Runtime airgap mode. Set these to 0 only when intentionally allowing
# runtime model downloads during development.
AIRGAP_RUNTIME_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_XET=1
DO_NOT_TRACK=1

RAG_JSON_NUM_PREDICT=4096
RAG_RETRIEVAL_TOKEN_BUDGET=12000
RAG_TOP_K=10
RAG_QUERY_PLANNER_ENABLED=true
RAG_QUERY_REWRITE_LLM_ENABLED=false
RAG_RETRIEVAL_MAX_RETRIES=1
RAG_DEFER_FAITHFULNESS=true
RAG_FAITHFULNESS_THRESHOLD=0.8
RAG_SOURCE_ROUTER_LLM_ENABLED=true
RAG_SOURCE_ROUTER_LLM_MIN_CONFIDENCE=0.60
RAG_HYBRID_DISAGREEMENT_DETECTOR_ENABLED=true
RAG_INTENT_ROUTER_VERSION=v1
RAG_ROUTE_LLM_VERIFIER_ENABLED=true
RAG_RERANKER_MAX_CANDIDATES=40
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_DENSE_CACHE_DIR=/models/fastembed
RAG_SPARSE_CACHE_DIR=/models/fastembed
RAG_RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
RAG_RERANKER_CACHE_DIR=/models/fastembed
RAG_SESSION_STORE=redis
RAG_SESSION_PREFIX=rag:session
RAG_SESSION_TTL_SECONDS=14400
GRAPHRAG_ENABLED=true
GRAPHRAG_COMMUNITY_COLLECTION=graphrag_community_summaries
GRAPHRAG_QUEUE_NAME=graphrag:jobs
GRAPHRAG_INDEX_TASK_NAME=apps.ingestion.tasks.index_document_graphrag
GRAPHRAG_PARTITION_REBUILD_TASK_NAME=apps.ingestion.tasks.rebuild_graphrag_partition
GRAPHRAG_EXTRACTION_CONCURRENCY=2
GRAPHRAG_SUMMARY_CONCURRENCY=2
GRAPHRAG_SUMMARIZE_AFTER_DOCUMENT=false
GRAPHRAG_PARTITION_REBUILD_DELAY_SECONDS=60
GRAPHRAG_MAX_CHUNKS_PER_DOC=0
GRAPHRAG_MIN_CHUNK_CHARS=80
GRAPHRAG_EXTRACTION_CHECKPOINT_TTL_SECONDS=86400
GRAPHRAG_TASK_SOFT_TIME_LIMIT_SECONDS=3600
GRAPHRAG_TASK_TIME_LIMIT_SECONDS=3900
GRAPHRAG_WORKER_BOOT_CONCURRENCY=1

VLLM_TEXT_MAX_MODEL_LEN=4096
VLLM_TEXT_GPU_MEMORY_UTILIZATION=0.12
VLLM_TEXT_KV_CACHE_MEMORY_BYTES=2G
VLLM_TEXT_MAX_NUM_SEQS=1
VLLM_TEXT_MAX_NUM_BATCHED_TOKENS=4096
VLLM_EMBED_MAX_MODEL_LEN=2048
VLLM_EMBED_GPU_MEMORY_UTILIZATION=0.05
VLLM_EMBED_MAX_NUM_SEQS=2
VLLM_EMBED_MAX_NUM_BATCHED_TOKENS=2048
VLLM_VISION_MAX_MODEL_LEN=2048
VLLM_VISION_GPU_MEMORY_UTILIZATION=0.10
VLLM_VISION_KV_CACHE_MEMORY_BYTES=2G
VLLM_VISION_MAX_NUM_SEQS=1
VLLM_VISION_MAX_NUM_BATCHED_TOKENS=2048

ARTIFACT_COMPOSER_TIMEOUT_SECONDS=60
ARTIFACT_MAINTENANCE_INTERVAL_SECONDS=300
ARTIFACT_RETENTION_DAYS=30
UPLOAD_STORAGE_DIR=/var/lib/agenticrag/uploads

VITE_API_BASE_URL=
VITE_POLLING_INTERVAL_MS=2000
