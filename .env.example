# Local AgenticRAG development defaults.
# Copy to .env only when you want to override docker-compose.yml defaults.

API_PORT=8000
FRONTEND_PORT=3000
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
VLLM_TEXT_PORT=8010
VLLM_EMBED_PORT=8011
VLLM_VISION_PORT=8016

POSTGRES_DB=agenticrag
POSTGRES_USER=agenticrag
POSTGRES_PASSWORD=agenticrag-local-password
REDIS_PASSWORD=agenticrag-local-redis-password
MINIO_ACCESS_KEY=agenticrag
MINIO_SECRET_KEY=agenticrag-local-minio-password
MINIO_BUCKET=agenticrag-uploads
CLAMAV_NO_FRESHCLAMD=true

JWT_SECRET_KEY=replace-with-local-jwt-secret
CSRF_SECRET_KEY=replace-with-local-csrf-secret
SERVICE_TOKEN=replace-with-local-service-token
BOOTSTRAP_ADMIN_EMAIL=admin@faham.ai
BOOTSTRAP_ADMIN_PASSWORD=12345678
DEPLOYMENT_CONTROLLER_URL=http://deployment-controller:8080
DEPLOYMENT_CONTROLLER_TIMEOUT_SECONDS=600
DEPLOYMENT_COMPOSE_TIMEOUT_SECONDS=900

RAG_MODEL_PROVIDER=vllm
VLLM_CHAT_MODEL=Qwen/Qwen3-8B-AWQ
RAG_REASONING_MODEL=Qwen/Qwen3-8B-AWQ
RAG_FAITHFULNESS_MODEL=Qwen/Qwen3-8B-AWQ
RAG_FAITHFULNESS_POLICY=never
RAG_ROUTE_LLM_VERIFIER_MODEL=Qwen/Qwen3-8B-AWQ
EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1.5
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_VISION_MODEL=

# Build-time cache priming. Keep PREWARM_DOCLING=false for reproducible
# offline rebuilds; seed the local model-cache folders while still connected.
FASTEMBED_CACHE_HOST_DIR=./model-cache/fastembed
DOCLING_CACHE_HOST_DIR=./model-cache/docling
PREWARM_FASTEMBED=false
PREWARM_DOCLING=false
DOCLING_CONVERT_TIMEOUT_SECONDS=180
DOCLING_OCR_BACKEND=onnxruntime
DOCLING_OCR_LANGS=english
OCR_REVIEW_CONFIDENCE_THRESHOLD=0.9
INGEST_TASK_SOFT_TIME_LIMIT_SECONDS=1800
INGEST_TASK_TIME_LIMIT_SECONDS=1920

# Runtime airgap mode. Set these to 0 only when intentionally allowing
# runtime model downloads during development.
AIRGAP_RUNTIME_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_XET=1
DO_NOT_TRACK=1

RAG_JSON_NUM_PREDICT=4096
RAG_RETRIEVAL_TOKEN_BUDGET=12000
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_SPARSE_CACHE_DIR=/models/fastembed
RAG_RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
RAG_RERANKER_CACHE_DIR=/models/fastembed

VLLM_TEXT_MAX_MODEL_LEN=4096
VLLM_TEXT_GPU_MEMORY_UTILIZATION=0.12
VLLM_TEXT_KV_CACHE_MEMORY_BYTES=2G
VLLM_TEXT_MAX_NUM_SEQS=1
VLLM_TEXT_MAX_NUM_BATCHED_TOKENS=4096
VLLM_EMBED_MAX_MODEL_LEN=2048
VLLM_EMBED_GPU_MEMORY_UTILIZATION=0.05
VLLM_EMBED_MAX_NUM_SEQS=2
VLLM_EMBED_MAX_NUM_BATCHED_TOKENS=2048
VLLM_VISION_MAX_MODEL_LEN=2048
VLLM_VISION_GPU_MEMORY_UTILIZATION=0.10
VLLM_VISION_KV_CACHE_MEMORY_BYTES=2G
VLLM_VISION_MAX_NUM_SEQS=1
VLLM_VISION_MAX_NUM_BATCHED_TOKENS=2048

ARTIFACT_RENDERER_MODE=sandbox
ARTIFACT_FAST_PAGINATED_RENDERER=true
ARTIFACT_COMPOSER_TIMEOUT_SECONDS=60
ARTIFACT_SANDBOX_URL=http://artifact-sandbox:8000
ARTIFACT_SANDBOX_TIMEOUT_SECONDS=120
ARTIFACT_SANDBOX_MAX_FILE_MB=30

VITE_API_BASE_URL=http://localhost:8000
VITE_POLLING_INTERVAL_MS=2000
